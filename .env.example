# These are examples; export variables in your shell. No dotenv dependency is needed.
HOST=127.0.0.1
PORT=8000
STOCKSENSE_DB=data/stocksense.db
STOCKSENSE_SECURE_COOKIE=0
# Enable ONLY during local development; prints reset codes in the server terminal.
STOCKSENSE_DEV_OTP=0
# Configure a STARTTLS-capable mail server for email-based password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
